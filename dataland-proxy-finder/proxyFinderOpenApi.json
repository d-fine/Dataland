{
  "openapi": "3.0.1",
  "info": {
    "title": "Dataland proxy finder API documentation",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/proxy-finder"
    }
  ],
  "tags": [
    {
      "name": "Actuator",
      "description": "Monitor and interact",
      "externalDocs": {
        "description": "Spring Boot Actuator Web API Documentation",
        "url": "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/"
      }
    }
  ],
  "paths": {
    "/proxy-suggestions/{companyId}": {
      "post": {
        "tags": [
          "proxy-suggestion-controller"
        ],
        "summary": "Find a proxy company for a company.",
        "description": "Searches a proxy company for the specified company and returns a validated proxy suggestion.",
        "operationId": "findProxySuggestion",
        "parameters": [
          {
            "name": "companyId",
            "in": "path",
            "description": "The unique identifier under which a company can be found on Dataland.",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "c9710c7b-9cd6-446b-85b0-3773d2aceb48"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully found a proxy suggestion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxySuggestion"
                }
              }
            }
          },
          "403": {
            "description": "Only Dataland admins may search proxy companies."
          },
          "404": {
            "description": "The specified company does not exist on Dataland."
          },
          "422": {
            "description": "The proxy suggestion is invalid, e.g. the suggested company does not exist on Dataland or is the company itself."
          },
          "default": {
            "description": "An error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "default-bearer-auth": []
          }
        ]
      }
    },
    "/actuator": {
      "get": {
        "tags": [
          "Actuator"
        ],
        "summary": "Actuator root web endpoint",
        "operationId": "links",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/Link"
                    }
                  }
                }
              },
              "application/vnd.spring-boot.actuator.v2+json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/Link"
                    }
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/Link"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/actuator/info": {
      "get": {
        "tags": [
          "Actuator"
        ],
        "summary": "Actuator web endpoint \u0027info\u0027",
        "operationId": "info",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "type": "object"
                }
              },
              "application/vnd.spring-boot.actuator.v2+json": {
                "schema": {
                  "type": "object"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "An error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/actuator/health": {
      "get": {
        "tags": [
          "Actuator"
        ],
        "summary": "Actuator web endpoint \u0027health\u0027",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "type": "object"
                }
              },
              "application/vnd.spring-boot.actuator.v2+json": {
                "schema": {
                  "type": "object"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "An error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProxySuggestion": {
        "required": [
          "companyId",
          "confidence",
          "proxyCompanyId",
          "reasoning",
          "sources"
        ],
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "description": "The Dataland company ID of the company for which a proxy company was searched.",
            "example": "c9710c7b-9cd6-446b-85b0-3773d2aceb48"
          },
          "proxyCompanyId": {
            "type": "string",
            "description": "The Dataland company ID of the suggested proxy company, whose data may be used as a proxy for the company.",
            "example": "f1fda7ba-4bd6-4f4c-9d6c-6d3b3a4e0c2a"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number",
            "description": "The confidence of the proxy finder in the suggestion, as a value between 0 (no confidence) and 1 (full confidence).",
            "format": "double",
            "example": 0.85
          },
          "reasoning": {
            "type": "string",
            "description": "A human-readable explanation of why the proxy company was suggested.",
            "example": "The suggested company is the parent company and publishes consolidated sustainability reports."
          },
          "sources": {
            "type": "array",
            "description": "The sources on which the suggestion is based.",
            "items": {
              "$ref": "#/components/schemas/ProxySuggestionSource"
            }
          }
        }
      },
      "ProxySuggestionSource": {
        "required": [
          "title",
          "url"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "A short human-readable title of the source.",
            "example": "Annual Report 2024"
          },
          "url": {
            "type": "string",
            "description": "The URL under which the source can be found.",
            "example": "https://example.com/annual-report-2024.pdf"
          }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "templated": {
            "type": "boolean"
          }
        }
      },
      "ErrorDetails": {
        "required": [
          "errorType",
          "httpStatus",
          "message",
          "summary"
        ],
        "type": "object",
        "properties": {
          "errorType": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "httpStatus": {
            "type": "number"
          },
          "metaInformation": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "errors"
        ],
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetails"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "default-bearer-auth": {
        "type": "http",
        "in": "header",
        "scheme": "bearer"
      }
    }
  }
}