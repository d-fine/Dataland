{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": [
    "config:best-practices"
  ],
  "labels": [
    "dependencies"
  ],
  "separateMinorPatch": true,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "minimumReleaseAge": "5 days",
  "updateNotScheduled": false,
  "timezone": "Europe/Berlin",
  "schedule": [
    "after 11pm every weekday",
    "before 6am every weekday",
    "every weekend"
  ],
  "packageRules": [
    {
      "groupName": "digest-bundle",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "digest"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "MAJOR"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "dependencies",
        "Minor"
      ]
    },
    {
      "groupName": "formkit-packages",
      "matchPackageNames": [
        "/^@formkit//"
      ]
    },
    {
      "groupName": "cloudevents",
      "matchPackageNames": [
        "/cloudevents/"
      ]
    },
    {
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Maven Central rate-limits Mend-hosted Renovate (HTTP 429), which aborts the whole run. Kotlin is updated manually until this is resolved.",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin[.:]/"
      ],
      "enabled": false
    }
  ]
}
